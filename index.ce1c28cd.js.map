"use strict";
document.addEventListener("click", function(e) {
    var spider = document.querySelector(".spider");
    var wall = e.target.closest(".wall");
    if (!wall) return;
    var newTop = Math.max(e.offsetY - spider.clientHeight / 2, 0);
    var newLeft = Math.max(e.offsetX - spider.clientWidth / 2, 0);
    newTop = Math.min(newTop, wall.clientHeight - spider.clientHeight);
    newLeft = Math.min(newLeft, wall.clientWidth - spider.clientWidth);
    spider.style.top = "".concat(newTop, "px");
    spider.style.left = "".concat(newLeft, "px");
});

